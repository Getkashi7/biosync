# ─────────────────────────────────────────────────────────────
# Pulse — environment template. Copy to .env and fill in.
# apps/mobile reads EXPO_PUBLIC_* at build time (public, ships in the bundle).
# apps/api reads the server-only vars below (never expose these to the client).
# ─────────────────────────────────────────────────────────────

# ── Mobile (apps/mobile/.env) ──────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Base URL the mobile client uses to reach apps/api (tRPC).
EXPO_PUBLIC_API_URL=http://localhost:4000

# §7 treatments: where an APPROVED review is booked. BIOSYNC never takes a
# booking itself — this opens the clinic's own site, and only from a request
# a practitioner has already approved. Leave unset and the button is simply
# absent (the card then says the practitioner will arrange it, which is true).
EXPO_PUBLIC_CLINIC_BOOKING_URL=

# Admin revenue figures. Optional: without it the revenue tile reports itself
# unavailable rather than showing a zero, and nothing else in the app changes.
# Use a sk_test_ key until Stripe Connect onboarding is done.
STRIPE_SECRET_KEY=

# ── API (apps/api/.env) ────────────────────────────────────────
# Pooled connection for the running server (Supabase: port 6543, pgbouncer).
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:6543/postgres?pgbouncer=true
# Direct connection for prisma migrate (Supabase: port 5432).
DIRECT_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres
# Project base URL — the API verifies ES256 access tokens against
# SUPABASE_URL/auth/v1/.well-known/jwks.json (new asymmetric signing keys).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Legacy HS256 JWT secret (Settings → API → JWT Settings). Only needed if your
# project still issues HS256 tokens; harmless to set alongside SUPABASE_URL.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# Groq API key for the AI Coach — free, no card (console.groq.com → API Keys).
# Optional — the chat degrades to a "not configured yet" reply when unset.
GROQ_API_KEY=gsk_...
# Optional Groq model override (default: llama-3.3-70b-versatile).
# GROQ_MODEL=llama-3.3-70b-versatile
# Port the standalone tRPC server listens on.
PORT=4000
