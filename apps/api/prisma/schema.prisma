// Pulse API data model. `User` mirrors Supabase auth.users by id (uuid); a
// handle_new_user trigger (see migrations) seeds a row on signup with role USER.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// PT and PRACTITIONER already exist as values in the live database (added by the
// rolled-back staff-roles slice). They are re-declared here so the schema matches
// the database — nothing reads them yet; the staff-role gating lands in a later
// slice. Without this the migration diff would try to remove them.
enum Role {
  USER
  ADMIN
  PT
  PRACTITIONER
}

// What a Metric measures. Objective point measurements live here; the subjective
// daily check-in stays in DailyLog.
enum MetricType {
  SLEEP_HOURS
  SLEEP_QUALITY
  RESTING_HR
  HRV
  GLUCOSE
  WEIGHT
  HYDRATION
  ENERGY
  MOOD
}

// A kind of data the user can choose to share.
enum ConsentCategory {
  BIOMETRICS
  JOURNAL
  DIAGNOSTICS
  PHOTOS
  ACTIVITY
}

// Who a category is shared with. NONE is the default everywhere — nothing is
// ever pre-consented.
enum ConsentAudience {
  NONE
  TRAINER
  PRACTITIONER
}

// When a supplement dose is taken. A supplement can carry several.
enum SupplementTiming {
  AM
  PRE
  PM
}

// Where a Metric came from. Only MANUAL is written today; the rest are the
// device integrations a later slice will sync from.
enum MetricSource {
  MANUAL
  HEALTH_CONNECT
  APPLE_HEALTH
  OURA
  WHOOP
  LIBRE
}

model User {
  id        String   @id @db.Uuid
  email     String   @unique
  fullName  String?  @map("full_name")
  role      Role     @default(USER)
  createdAt DateTime @default(now()) @map("created_at")

  dailyLogs           DailyLog[]
  metrics             Metric[]
  goals               Goal[]
  readinessSnapshots  ReadinessSnapshot[]
  meals               Meal[]
  supplements         Supplement[]
  supplementLogs      SupplementLog[]
  consents            Consent[]
  /** links where this user is the client */
  careTeam            StaffLink[] @relation("StaffLinkClient")
  /** links where this user is the staff member */
  clients             StaffLink[] @relation("StaffLinkStaff")
  plansWritten        TrainingPlan[] @relation("PlanTrainer")
  plansReceived       TrainingPlan[] @relation("PlanClient")
  notesWritten        SessionNote[]  @relation("NoteTrainer")
  notesReceived       SessionNote[]  @relation("NoteClient")

  @@map("users")
}

// One check-in per user per calendar day (upsert on the composite unique).
// `date` is the user's device-local day stored as a bare DATE.
model DailyLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  date         DateTime @db.Date
  sleepHours   Float    @map("sleep_hours")
  sleepQuality Int      @map("sleep_quality")
  energy       Int
  mood         Int
  weightKg     Float?   @map("weight_kg")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@map("daily_logs")
}

// A single point measurement at an instant — unlike DailyLog there is one row per
// reading, so a type can be logged many times a day (and later synced from a
// device). The index serves the range query: one user, one type, ordered by time.
model Metric {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  type       MetricType
  value      Float
  source     MetricSource @default(MANUAL)
  recordedAt DateTime     @default(now()) @map("recorded_at")
  createdAt  DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, recordedAt])
  @@map("metrics")
}

// A stored daily readiness score — the source of truth for the Insights trend.
// Written (upserted) whenever the day's readiness inputs change: on each check-in,
// and lazily backfilled for recent days by `insights.list`. `score` is the same
// 0–100 `computeReadiness` produces; a day that scores null (nothing logged) is
// simply never written. One row per user per device-local day.
model ReadinessSnapshot {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  date      DateTime @db.Date
  score     Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@map("readiness_snapshots")
}

// One logged meal. Macros are stored in grams, energy in kcal. `date` is the
// user's device-local day (a bare DATE) so a day's totals bucket correctly
// regardless of timezone, while `loggedAt` keeps the ordering within that day.
// `estimated` records whether the macros came from the AI estimate untouched or
// were adjusted by the user — the UI surfaces that distinction.
model Meal {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  date        DateTime @db.Date
  description String
  calories    Int
  proteinG    Float    @map("protein_g")
  carbsG      Float    @map("carbs_g")
  fatG        Float    @map("fat_g")
  fiberG      Float?   @map("fiber_g")
  estimated   Boolean  @default(true)
  loggedAt    DateTime @default(now()) @map("logged_at")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("meals")
}

// One entry in the user's own supplement stack. Everything here is USER-entered:
// the app never prescribes. `dose` is free text ("2000 IU", "5 g") so any unit
// works, and `timings` says when in the day it's taken. Informational only.
model Supplement {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  name      String
  dose      String
  timings   SupplementTiming[]
  /** the user's own note on why they take it */
  note      String?
  active    Boolean            @default(true)
  createdAt DateTime           @default(now()) @map("created_at")

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs SupplementLog[]

  @@index([userId])
  @@map("supplements")
}

// A single taken-dose tick. One row per supplement per device-local day per
// timing, so the day's strip can show take-off checkmarks idempotently.
model SupplementLog {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  supplementId String           @map("supplement_id") @db.Uuid
  date         DateTime         @db.Date
  timing       SupplementTiming
  createdAt    DateTime         @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplement Supplement @relation(fields: [supplementId], references: [id], onDelete: Cascade)

  @@unique([supplementId, date, timing])
  @@index([userId, date])
  @@map("supplement_logs")
}

// Whether a staff member is actually connected to a client.
enum StaffLinkStatus {
  PENDING
  ACTIVE
  REVOKED
}

// The link between a client and a staff member. Consent says "my trainer may see
// my activity"; this says WHO that trainer is. Both are required before any
// staff member can read a client's data — consent alone grants nothing, and a
// link alone grants nothing.
model StaffLink {
  id        String          @id @default(uuid()) @db.Uuid
  clientId  String          @map("client_id") @db.Uuid
  staffId   String          @map("staff_id") @db.Uuid
  /** the capacity the staff member acts in for this client */
  role      Role
  status    StaffLinkStatus @default(PENDING)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  client User @relation("StaffLinkClient", fields: [clientId], references: [id], onDelete: Cascade)
  staff  User @relation("StaffLinkStaff", fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([clientId, staffId, role])
  @@index([staffId, status])
  @@index([clientId, status])
  @@map("staff_links")
}

// One consent decision: which category, shared with whom. A missing row means
// NONE — the absence of a decision is never treated as permission.
model Consent {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  category  ConsentCategory
  audience  ConsentAudience @default(NONE)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId])
  @@map("consents")
}

// A week's training plan a trainer assigns to a client. The exercises live in
// `items` as an ordered JSON array ([{name, sets, reps}]) — the builder reorders
// them by dragging, so array position IS the order and a separate row-per-
// exercise table would buy nothing.
model TrainingPlan {
  id        String   @id @default(uuid()) @db.Uuid
  trainerId String   @map("trainer_id") @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  /** ISO week the plan targets, e.g. "2026-W30" */
  week      String
  title     String
  items     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  trainer User @relation("PlanTrainer", fields: [trainerId], references: [id], onDelete: Cascade)
  client  User @relation("PlanClient", fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([trainerId, clientId, week])
  @@index([clientId])
  @@map("training_plans")
}

// A note a trainer writes after a session. `sharedWithClient` decides whether the
// client can read it — the composer says so plainly, and the client-facing query
// filters on it.
model SessionNote {
  id               String   @id @default(uuid()) @db.Uuid
  trainerId        String   @map("trainer_id") @db.Uuid
  clientId         String   @map("client_id") @db.Uuid
  body             String
  sharedWithClient Boolean  @default(true) @map("shared_with_client")
  createdAt        DateTime @default(now()) @map("created_at")

  trainer User @relation("NoteTrainer", fields: [trainerId], references: [id], onDelete: Cascade)
  client  User @relation("NoteClient", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@index([trainerId, createdAt])
  @@map("session_notes")
}

// An append-only record of who did what, for the compliance layer.
//
// Deliberately has NO foreign keys to `users`: an audit trail has to outlive the
// records it describes, so a right-to-erasure deletion must not cascade these
// rows away. `actorId`/`subjectId` are therefore plain uuid columns.
//
// It stores WHAT happened, never the health values involved — `meta` is passed
// through `sanitiseAuditMeta` first, which strips nested data and known
// health-bearing keys.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  /** who performed the action */
  actorId   String   @map("actor_id") @db.Uuid
  /** whose record it affected, when that differs from the actor (staff access) */
  subjectId String?  @map("subject_id") @db.Uuid
  action    String
  /** the kind of record touched, e.g. "meal", "supplement" */
  entity    String?
  entityId  String?  @map("entity_id")
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([subjectId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// A user's stated goal, optionally tied to the metric that measures it.
model Goal {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @map("user_id") @db.Uuid
  description  String
  targetMetric MetricType? @map("target_metric")
  createdAt    DateTime    @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("goals")
}
