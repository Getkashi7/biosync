generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String              @id @db.Uuid
  email              String              @unique
  fullName           String?             @map("full_name")
  role               Role                @default(USER)
  createdAt          DateTime            @default(now()) @map("created_at")
  invitesAccepted    ClientInvite[]      @relation("InviteClient")
  invitesSent        ClientInvite[]      @relation("InviteStaff")
  consents           Consent[]
  dailyLogs          DailyLog[]
  goals              Goal[]
  meals              Meal[]
  metrics            Metric[]
  notificationNudges NotificationNudge[]
  notificationPrefs  NotificationPrefs?
  photos             Photo[]
  readinessSnapshots ReadinessSnapshot[]
  notesReceived      SessionNote[]       @relation("NoteClient")
  notesWritten       SessionNote[]       @relation("NoteTrainer")
  careTeam           StaffLink[]         @relation("StaffLinkClient")
  clients            StaffLink[]         @relation("StaffLinkStaff")
  staffProfiles      StaffProfile[]
  supplementLogs     SupplementLog[]
  supplements        Supplement[]
  plansReceived      TrainingPlan[]      @relation("PlanClient")
  plansWritten       TrainingPlan[]      @relation("PlanTrainer")
  treatmentRequests  TreatmentRequest[]  @relation("TreatmentClient")
  treatmentReviews   TreatmentRequest[]  @relation("TreatmentReviewer")

  @@map("users")
}

model DailyLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  date         DateTime @db.Date
  sleepHours   Float    @map("sleep_hours")
  sleepQuality Int      @map("sleep_quality")
  energy       Int
  mood         Int
  weightKg     Float?   @map("weight_kg")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@map("daily_logs")
}

model Metric {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  type       MetricType
  value      Float
  source     MetricSource @default(MANUAL)
  recordedAt DateTime     @default(now()) @map("recorded_at")
  createdAt  DateTime     @default(now()) @map("created_at")
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, recordedAt])
  @@map("metrics")
}

model ReadinessSnapshot {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  date      DateTime @db.Date
  score     Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@map("readiness_snapshots")
}

model Meal {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  date        DateTime @db.Date
  description String
  calories    Int
  proteinG    Float    @map("protein_g")
  carbsG      Float    @map("carbs_g")
  fatG        Float    @map("fat_g")
  fiberG      Float?   @map("fiber_g")
  estimated   Boolean  @default(true)
  loggedAt    DateTime @default(now()) @map("logged_at")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("meals")
}

model Supplement {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  name      String
  dose      String
  timings   SupplementTiming[]
  /// the user's own note on why they take it
  note      String?
  active    Boolean            @default(true)
  createdAt DateTime           @default(now()) @map("created_at")
  logs      SupplementLog[]
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("supplements")
}

model SupplementLog {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  supplementId String           @map("supplement_id") @db.Uuid
  date         DateTime         @db.Date
  timing       SupplementTiming
  createdAt    DateTime         @default(now()) @map("created_at")
  supplement   Supplement       @relation(fields: [supplementId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([supplementId, date, timing])
  @@index([userId, date])
  @@map("supplement_logs")
}

model StaffProfile {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String      @map("user_id") @db.Uuid
  kind       StaffKind
  status     StaffStatus @default(PENDING)
  /// free text for now: registration number, insurer, etc.
  credential String?
  verifiedAt DateTime?   @map("verified_at")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@index([status])
  @@map("staff_profiles")
}

model StaffLink {
  id        String          @id @default(uuid()) @db.Uuid
  clientId  String          @map("client_id") @db.Uuid
  staffId   String          @map("staff_id") @db.Uuid
  /// The capacity the staff member acts in for this client.
  /// `role` is the legacy column and is being retired: it reused the `Role` enum,
  /// which allowed meaningless links (role = ADMIN). `kind` replaces it and is
  /// nullable only for the length of the backfill — reads move to `kind`, then
  /// `role` is dropped in a later migration. Never change a column's type in
  /// place; that generates a destructive migration.
  role      Role
  status    StaffLinkStatus @default(PENDING)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  kind      StaffKind?
  client    User            @relation("StaffLinkClient", fields: [clientId], references: [id], onDelete: Cascade)
  staff     User            @relation("StaffLinkStaff", fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([clientId, staffId, role])
  @@index([staffId, status])
  @@index([clientId, status])
  @@map("staff_links")
}

model ClientInvite {
  id         String    @id @default(uuid()) @db.Uuid
  staffId    String    @map("staff_id") @db.Uuid
  /// the capacity the resulting link will be held in
  kind       StaffKind
  /// sha-256 of the normalised code; the plaintext exists only at creation
  codeHash   String    @unique @map("code_hash")
  /// Optional: when set, only this email may redeem the invite. Stored
  /// lower-cased. Null means "anyone holding the code", which is why expiry and
  /// single use matter.
  email      String?
  expiresAt  DateTime  @map("expires_at")
  /// set on redemption; a non-null value means the code is spent
  acceptedAt DateTime? @map("accepted_at")
  acceptedBy String?   @map("accepted_by") @db.Uuid
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  client     User?     @relation("InviteClient", fields: [acceptedBy], references: [id])
  staff      User      @relation("InviteStaff", fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, createdAt])
  @@map("client_invites")
}

model Consent {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  category  ConsentCategory
  audience  ConsentAudience @default(NONE)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId])
  @@map("consents")
}

model TrainingPlan {
  id        String   @id @default(uuid()) @db.Uuid
  trainerId String   @map("trainer_id") @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  /// ISO week the plan targets, e.g. "2026-W30"
  week      String
  title     String
  items     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  client    User     @relation("PlanClient", fields: [clientId], references: [id], onDelete: Cascade)
  trainer   User     @relation("PlanTrainer", fields: [trainerId], references: [id], onDelete: Cascade)

  @@unique([trainerId, clientId, week])
  @@index([clientId])
  @@map("training_plans")
}

model SessionNote {
  id               String   @id @default(uuid()) @db.Uuid
  trainerId        String   @map("trainer_id") @db.Uuid
  clientId         String   @map("client_id") @db.Uuid
  body             String
  sharedWithClient Boolean  @default(true) @map("shared_with_client")
  createdAt        DateTime @default(now()) @map("created_at")
  client           User     @relation("NoteClient", fields: [clientId], references: [id], onDelete: Cascade)
  trainer          User     @relation("NoteTrainer", fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@index([trainerId, createdAt])
  @@map("session_notes")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  /// who performed the action
  actorId   String   @map("actor_id") @db.Uuid
  /// whose record it affected, when that differs from the actor (staff access)
  subjectId String?  @map("subject_id") @db.Uuid
  action    String
  /// the kind of record touched, e.g. "meal", "supplement"
  entity    String?
  entityId  String?  @map("entity_id")
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([subjectId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model Goal {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @map("user_id") @db.Uuid
  description  String
  targetMetric MetricType? @map("target_metric")
  createdAt    DateTime    @default(now()) @map("created_at")
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("goals")
}

/// A progress photo. The image itself lives in the private `progress-photos`
/// Supabase Storage bucket and is never public; only its path is stored here,
/// so a leaked row on its own reveals no imagery. Reads go through short-lived
/// signed URLs the API mints after checking link + consent.
model Photo {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  /// Path inside the private bucket, "<userId>/<uuid>.<ext>".
  storagePath String           @map("storage_path")
  /// The day the photo represents, in the user's own local clock. The timeline
  /// groups by this rather than upload time — a photo taken this morning and
  /// uploaded tonight belongs to this morning.
  takenOn     DateTime         @map("taken_on") @db.Date
  /// Per-photo visibility, and the thing the lock chip on the thumbnail marks.
  /// Null means "follow my PHOTOS consent audience". A value here can only make
  /// one photo *more* private than the category default — it is intersected
  /// with the category consent, never used to widen past it, so a single photo
  /// can never be shared with someone the user hasn't consented to.
  audienceOverride ConsentAudience? @map("audience_override")
  mimeType    String           @map("mime_type")
  byteSize    Int              @map("byte_size")
  createdAt   DateTime         @default(now()) @map("created_at")
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, takenOn])
  @@map("photos")
}

/// Quiet hours — one row per user, covering every nudge. Times are "HH:MM" in
/// the user's device-local clock, not UTC: 22:00 means ten at night wherever
/// they are, and an instant would drift the moment they travel.
model NotificationPrefs {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @map("user_id") @db.Uuid
  quietStart String   @default("22:00") @map("quiet_start")
  quietEnd   String   @default("07:00") @map("quiet_end")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_prefs")
}

/// One row per nudge the user has touched. Absent rows fall back to the shared
/// defaults (all off), so a new nudge type ships without backfilling anyone.
/// The device still schedules these locally; the server only remembers them.
model NotificationNudge {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      NudgeType
  enabled   Boolean   @default(false)
  /// "HH:MM" device-local; null when the user hasn't picked a time yet.
  time      String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
  @@map("notification_nudges")
}

enum Role {
  USER
  ADMIN
  PT
  PRACTITIONER
}

/// The nudges that have something real behind them. Appointment nudges land
/// with booking (§6/§7) — a toggle that can never fire would be a lie.
/// Mirrors NUDGE_TYPES in @pulse/shared; keep the two in step.
enum NudgeType {
  CHECK_IN
  MORNING_DIGEST
  SUPPLEMENTS
  HYDRATION
  GOALS
}

enum MetricType {
  SLEEP_HOURS
  SLEEP_QUALITY
  RESTING_HR
  HRV
  GLUCOSE
  WEIGHT
  HYDRATION
  ENERGY
  MOOD
}

enum ConsentCategory {
  BIOMETRICS
  JOURNAL
  DIAGNOSTICS
  PHOTOS
  ACTIVITY
}

enum ConsentAudience {
  NONE
  TRAINER
  PRACTITIONER
}

enum SupplementTiming {
  AM
  PRE
  PM
}

enum MetricSource {
  MANUAL
  HEALTH_CONNECT
  APPLE_HEALTH
  OURA
  WHOOP
  LIBRE
}

enum StaffKind {
  PT
  PRACTITIONER
}

enum StaffStatus {
  PENDING
  VERIFIED
  SUSPENDED
}

enum StaffLinkStatus {
  PENDING
  ACTIVE
  REVOKED
}

/// §7 treatment requests. A request is created only when the client asks —
/// suggestions themselves are computed, never stored, so nothing is written
/// until a person acts.
enum TreatmentStatus {
  REQUESTED
  APPROVED
  DECLINED
  WITHDRAWN
  EXPIRED
}

/// One client's request for a practitioner to review a treatment protocol.
///
/// The row is the durable record that a clinical decision was made by a named
/// person at a known time, so it outlives the reviewer's account (the reviewer
/// FK nulls rather than cascading) and its decision fields are never rewritten
/// once set.
model TreatmentRequest {
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @map("user_id") @db.Uuid
  /// Slug from TREATMENT_PROTOCOLS in @pulse/shared. Stored, not referenced:
  /// the catalogue is code reviewed in pull requests, not a table an admin
  /// screen can edit. `protocolName()` degrades a retired slug gracefully.
  protocolSlug String          @map("protocol_slug")
  status       TreatmentStatus @default(REQUESTED)
  /// The data-derived reason as it read AT REQUEST TIME. Frozen deliberately:
  /// it is what the client saw when they asked, and a practitioner reviewing a
  /// week later must see that, not a figure recomputed from newer readings.
  reason       String
  /// The client's optional note to the reviewer.
  note         String?
  reviewedById String?         @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime?       @map("reviewed_at")
  /// Set only on approval; `canProceedToBooking` treats a null here on an
  /// APPROVED row as not-approved, because an unreadable authorisation is not
  /// an authorisation.
  approvedAt   DateTime?       @map("approved_at")
  /// Required on DECLINE, optional on APPROVE.
  decisionNote String?         @map("decision_note")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  user         User            @relation("TreatmentClient", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?           @relation("TreatmentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("treatment_requests")
}
