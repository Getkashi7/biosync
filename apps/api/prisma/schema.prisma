generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String              @id @db.Uuid
  email              String              @unique
  fullName           String?             @map("full_name")
  role               Role                @default(USER)
  createdAt          DateTime            @default(now()) @map("created_at")
  invitesAccepted    ClientInvite[]      @relation("InviteClient")
  invitesSent        ClientInvite[]      @relation("InviteStaff")
  consents           Consent[]
  dailyLogs          DailyLog[]
  goals              Goal[]
  meals              Meal[]
  metrics            Metric[]
  notificationNudges NotificationNudge[]
  notificationPrefs  NotificationPrefs?
  photos             Photo[]
  readinessSnapshots ReadinessSnapshot[]
  notesReceived      SessionNote[]       @relation("NoteClient")
  notesWritten       SessionNote[]       @relation("NoteTrainer")
  careTeam           StaffLink[]         @relation("StaffLinkClient")
  clients            StaffLink[]         @relation("StaffLinkStaff")
  staffProfiles      StaffProfile[]
  supplementLogs     SupplementLog[]
  supplements        Supplement[]
  plansReceived      TrainingPlan[]      @relation("PlanClient")
  plansWritten       TrainingPlan[]      @relation("PlanTrainer")
  fitnessSessions    FitnessSession[]
  treatmentRequests  TreatmentRequest[]  @relation("TreatmentClient")
  treatmentReviews   TreatmentRequest[]  @relation("TreatmentReviewer")
  coachProfile       CoachProfile?
  classesCoached     GymClass[]          @relation("ClassCoach")
  classBookings      ClassBooking[]
  gymVisits          GymVisit[]

  /// Serves the admin `recent` browse — newest members first, unfiltered.
  @@index([createdAt])
  @@map("users")
}

model DailyLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  date         DateTime @db.Date
  sleepHours   Float    @map("sleep_hours")
  sleepQuality Int      @map("sleep_quality")
  energy       Int
  mood         Int
  weightKg     Float?   @map("weight_kg")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@map("daily_logs")
}

model Metric {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  type       MetricType
  value      Float
  source     MetricSource @default(MANUAL)
  recordedAt DateTime     @default(now()) @map("recorded_at")
  createdAt  DateTime     @default(now()) @map("created_at")
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, recordedAt])
  @@map("metrics")
}

model ReadinessSnapshot {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  date      DateTime @db.Date
  score     Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@map("readiness_snapshots")
}

model Meal {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  date        DateTime @db.Date
  description String
  calories    Int
  proteinG    Float    @map("protein_g")
  carbsG      Float    @map("carbs_g")
  fatG        Float    @map("fat_g")
  fiberG      Float?   @map("fiber_g")
  estimated   Boolean  @default(true)
  loggedAt    DateTime @default(now()) @map("logged_at")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("meals")
}

model Supplement {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  name      String
  dose      String
  timings   SupplementTiming[]
  /// the user's own note on why they take it
  note      String?
  active    Boolean            @default(true)
  createdAt DateTime           @default(now()) @map("created_at")
  logs      SupplementLog[]
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("supplements")
}

model SupplementLog {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  supplementId String           @map("supplement_id") @db.Uuid
  date         DateTime         @db.Date
  timing       SupplementTiming
  createdAt    DateTime         @default(now()) @map("created_at")
  supplement   Supplement       @relation(fields: [supplementId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([supplementId, date, timing])
  @@index([userId, date])
  @@map("supplement_logs")
}

model StaffProfile {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String      @map("user_id") @db.Uuid
  kind       StaffKind
  status     StaffStatus @default(PENDING)
  /// free text for now: registration number, insurer, etc.
  credential String?
  verifiedAt DateTime?   @map("verified_at")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@index([status])
  @@map("staff_profiles")
}

model StaffLink {
  id        String          @id @default(uuid()) @db.Uuid
  clientId  String          @map("client_id") @db.Uuid
  staffId   String          @map("staff_id") @db.Uuid
  /// The capacity the staff member acts in for this client.
  /// `role` is the legacy column and is being retired: it reused the `Role` enum,
  /// which allowed meaningless links (role = ADMIN). `kind` replaces it and is
  /// nullable only for the length of the backfill — reads move to `kind`, then
  /// `role` is dropped in a later migration. Never change a column's type in
  /// place; that generates a destructive migration.
  role      Role
  status    StaffLinkStatus @default(PENDING)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  kind      StaffKind?
  client    User            @relation("StaffLinkClient", fields: [clientId], references: [id], onDelete: Cascade)
  staff     User            @relation("StaffLinkStaff", fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([clientId, staffId, role])
  @@index([staffId, status])
  @@index([clientId, status])
  @@map("staff_links")
}

model ClientInvite {
  id         String    @id @default(uuid()) @db.Uuid
  staffId    String    @map("staff_id") @db.Uuid
  /// the capacity the resulting link will be held in
  kind       StaffKind
  /// sha-256 of the normalised code; the plaintext exists only at creation
  codeHash   String    @unique @map("code_hash")
  /// Optional: when set, only this email may redeem the invite. Stored
  /// lower-cased. Null means "anyone holding the code", which is why expiry and
  /// single use matter.
  email      String?
  expiresAt  DateTime  @map("expires_at")
  /// set on redemption; a non-null value means the code is spent
  acceptedAt DateTime? @map("accepted_at")
  acceptedBy String?   @map("accepted_by") @db.Uuid
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  client     User?     @relation("InviteClient", fields: [acceptedBy], references: [id])
  staff      User      @relation("InviteStaff", fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, createdAt])
  @@map("client_invites")
}

model Consent {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  category  ConsentCategory
  audience  ConsentAudience @default(NONE)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId])
  @@map("consents")
}

model TrainingPlan {
  id        String   @id @default(uuid()) @db.Uuid
  trainerId String   @map("trainer_id") @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  /// ISO week the plan targets, e.g. "2026-W30"
  week      String
  title     String
  items     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  client    User     @relation("PlanClient", fields: [clientId], references: [id], onDelete: Cascade)
  trainer   User     @relation("PlanTrainer", fields: [trainerId], references: [id], onDelete: Cascade)

  @@unique([trainerId, clientId, week])
  @@index([clientId])
  @@map("training_plans")
}

model SessionNote {
  id               String   @id @default(uuid()) @db.Uuid
  trainerId        String   @map("trainer_id") @db.Uuid
  clientId         String   @map("client_id") @db.Uuid
  body             String
  sharedWithClient Boolean  @default(true) @map("shared_with_client")
  createdAt        DateTime @default(now()) @map("created_at")
  client           User     @relation("NoteClient", fields: [clientId], references: [id], onDelete: Cascade)
  trainer          User     @relation("NoteTrainer", fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@index([trainerId, createdAt])
  @@map("session_notes")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  /// who performed the action
  actorId   String   @map("actor_id") @db.Uuid
  /// whose record it affected, when that differs from the actor (staff access)
  subjectId String?  @map("subject_id") @db.Uuid
  action    String
  /// the kind of record touched, e.g. "meal", "supplement"
  entity    String?
  entityId  String?  @map("entity_id")
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([subjectId, createdAt])
  @@index([action, createdAt])
  /// Serves the unfiltered viewer: none of the composites above can answer
  /// an ORDER BY created_at DESC without a scan, on a table that only grows.
  @@index([createdAt])
  @@map("audit_logs")
}

model Goal {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @map("user_id") @db.Uuid
  description  String
  targetMetric MetricType? @map("target_metric")
  createdAt    DateTime    @default(now()) @map("created_at")
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("goals")
}

/// A progress photo. The image itself lives in the private `progress-photos`
/// Supabase Storage bucket and is never public; only its path is stored here,
/// so a leaked row on its own reveals no imagery. Reads go through short-lived
/// signed URLs the API mints after checking link + consent.
model Photo {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  /// Path inside the private bucket, "<userId>/<uuid>.<ext>".
  storagePath      String           @map("storage_path")
  /// The day the photo represents, in the user's own local clock. The timeline
  /// groups by this rather than upload time — a photo taken this morning and
  /// uploaded tonight belongs to this morning.
  takenOn          DateTime         @map("taken_on") @db.Date
  /// Per-photo visibility, and the thing the lock chip on the thumbnail marks.
  /// Null means "follow my PHOTOS consent audience". A value here can only make
  /// one photo *more* private than the category default — it is intersected
  /// with the category consent, never used to widen past it, so a single photo
  /// can never be shared with someone the user hasn't consented to.
  audienceOverride ConsentAudience? @map("audience_override")
  mimeType         String           @map("mime_type")
  byteSize         Int              @map("byte_size")
  createdAt        DateTime         @default(now()) @map("created_at")
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, takenOn])
  @@map("photos")
}

/// Quiet hours — one row per user, covering every nudge. Times are "HH:MM" in
/// the user's device-local clock, not UTC: 22:00 means ten at night wherever
/// they are, and an instant would drift the moment they travel.
model NotificationPrefs {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @map("user_id") @db.Uuid
  quietStart String   @default("22:00") @map("quiet_start")
  quietEnd   String   @default("07:00") @map("quiet_end")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_prefs")
}

/// One row per nudge the user has touched. Absent rows fall back to the shared
/// defaults (all off), so a new nudge type ships without backfilling anyone.
/// The device still schedules these locally; the server only remembers them.
model NotificationNudge {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      NudgeType
  enabled   Boolean   @default(false)
  /// "HH:MM" device-local; null when the user hasn't picked a time yet.
  time      String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
  @@map("notification_nudges")
}

enum Role {
  USER
  ADMIN
  PT
  PRACTITIONER
}

/// The nudges that have something real behind them. Appointment nudges land
/// with booking (§6/§7) — a toggle that can never fire would be a lie.
/// Mirrors NUDGE_TYPES in @pulse/shared; keep the two in step.
enum NudgeType {
  CHECK_IN
  MORNING_DIGEST
  SUPPLEMENTS
  HYDRATION
  GOALS
}

enum MetricType {
  SLEEP_HOURS
  SLEEP_QUALITY
  RESTING_HR
  HRV
  GLUCOSE
  WEIGHT
  HYDRATION
  ENERGY
  MOOD
}

enum ConsentCategory {
  BIOMETRICS
  JOURNAL
  DIAGNOSTICS
  PHOTOS
  ACTIVITY
}

enum ConsentAudience {
  NONE
  TRAINER
  PRACTITIONER
}

enum SupplementTiming {
  AM
  PRE
  PM
}

enum MetricSource {
  MANUAL
  HEALTH_CONNECT
  APPLE_HEALTH
  OURA
  WHOOP
  LIBRE
}

enum StaffKind {
  PT
  PRACTITIONER
}

enum StaffStatus {
  PENDING
  VERIFIED
  SUSPENDED
}

enum StaffLinkStatus {
  PENDING
  ACTIVE
  REVOKED
}

/// §7 treatment requests. A request is created only when the client asks —
/// suggestions themselves are computed, never stored, so nothing is written
/// until a person acts.
enum TreatmentStatus {
  REQUESTED
  APPROVED
  DECLINED
  WITHDRAWN
  EXPIRED
}

/// One client's request for a practitioner to review a treatment protocol.
///
/// The row is the durable record that a clinical decision was made by a named
/// person at a known time, so it outlives the reviewer's account (the reviewer
/// FK nulls rather than cascading) and its decision fields are never rewritten
/// once set.
model TreatmentRequest {
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @map("user_id") @db.Uuid
  /// Slug from TREATMENT_PROTOCOLS in @pulse/shared. Stored, not referenced:
  /// the catalogue is code reviewed in pull requests, not a table an admin
  /// screen can edit. `protocolName()` degrades a retired slug gracefully.
  protocolSlug String          @map("protocol_slug")
  status       TreatmentStatus @default(REQUESTED)
  /// The data-derived reason as it read AT REQUEST TIME. Frozen deliberately:
  /// it is what the client saw when they asked, and a practitioner reviewing a
  /// week later must see that, not a figure recomputed from newer readings.
  reason       String
  /// The client's optional note to the reviewer.
  note         String?
  reviewedById String?         @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime?       @map("reviewed_at")
  /// Set only on approval; `canProceedToBooking` treats a null here on an
  /// APPROVED row as not-approved, because an unreadable authorisation is not
  /// an authorisation.
  approvedAt   DateTime?       @map("approved_at")
  /// Required on DECLINE, optional on APPROVE.
  decisionNote String?         @map("decision_note")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  user         User            @relation("TreatmentClient", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?           @relation("TreatmentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("treatment_requests")
}

/// How a finished session felt. Drives the next one, by a bounded amount —
/// see `feedbackAdjustment` in @pulse/shared.
enum SessionFeedback {
  TOO_HARD
  JUST_RIGHT
  TOO_EASY
}

/// One planned training day (§3). A week is seven of these.
///
/// The plan is generated by rule from the user's own readiness and goals, never
/// by a model — see `buildWeek` in @pulse/shared. Rows are written when a week
/// is first opened and then belong to the user: check-offs and feedback are
/// theirs, so a regeneration must never silently discard them.
model FitnessSession {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  /// The day this session is for, in the user's own local clock.
  date        DateTime         @db.Date
  /// "" on a rest day.
  title       String
  /// PlannedExercise[] — name, sets, reps, target, and the check-off state.
  items       Json
  /// 0–100 planned load; tints the day on the week spine. 0 on a rest day.
  intensity   Int
  /// The readiness this was built against, frozen at generation time so the
  /// rationale still makes sense tomorrow.
  readiness   Int?
  /// Why this session looks like this — restates the user's own score.
  rationale   String
  rest        Boolean          @default(false)
  completedAt DateTime?        @map("completed_at")
  feedback    SessionFeedback?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("fitness_sessions")
}

/// A coach's PUBLIC identity — deliberately separate from StaffProfile.
///
/// StaffProfile is the PERMISSION record and holds `credential`, a professional
/// registration number that must never reach a client. This is the
/// ADVERTISEMENT record. Keeping them apart makes "never expose the credential"
/// a property of which table you query rather than a select list someone has to
/// get right at every call site.
///
/// They also have different actors and different cardinality: an admin grants a
/// capability, a coach opts into being advertised, and a person who holds both
/// PT and PRACTITIONER still has one bio and one photo.
///
/// `listed` never publishes anyone on its own — the directory query also
/// requires a VERIFIED PT StaffProfile, so a suspension delists on the next read
/// with no backfill job to forget.
model CoachProfile {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @unique @map("user_id") @db.Uuid
  displayName          String    @map("display_name")
  /// Free text, checked for health claims at the boundary by `bioClaimFlags`.
  bio                  String?
  /// Slugs from COACH_SPECIALTIES in @pulse/shared — never free text. A public
  /// directory of free-text specialties is an uncontrolled health-claim surface.
  specialties          String[]
  /// "<userId>/coach-<uuid>.<ext>" in the private bucket, served through a
  /// short-lived signed URL. Under the user's OWN prefix on purpose, so
  /// `deleteAllUserObjects` purges it with the rest of their account.
  photoPath            String?   @map("photo_path")
  /// The coach's own booking page. BIOSYNC takes no money — the same hand-off
  /// posture as EXPO_PUBLIC_CLINIC_BOOKING_URL in §7.
  bookingUrl           String?   @map("booking_url")
  /// The coach's own opt-in. Necessary, never sufficient — see the header.
  listed               Boolean   @default(false)
  /// Connect, modelled now and onboarded later. A non-null account id does NOT
  /// mean they can be paid: an account exists long before KYC completes, so
  /// only `stripeChargesEnabled` may gate a payment action. Never returned to
  /// a client.
  stripeAccountId      String?   @unique @map("stripe_account_id")
  stripeChargesEnabled Boolean   @default(false) @map("stripe_charges_enabled")
  stripeOnboardedAt    DateTime? @map("stripe_onboarded_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([listed])
  @@map("coach_profiles")
}

/// A physical place classes happen in, and check-ins happen at.
///
/// Needed for a QR check-in to mean anything: a code encoding a CLASS can be
/// screenshotted and reused from home, whereas a venue's rotating secret means
/// "someone was in front of this display in the last minute".
model Venue {
  id            String     @id @default(uuid()) @db.Uuid
  name          String
  /// One line, for display. Not structured — nothing here geocodes.
  address       String?
  /// IANA zone. `GymClass.startsAt` is an instant; this is what turns it back
  /// into a wall clock across BST/GMT and for someone browsing from abroad.
  timezone      String     @default("Europe/London")
  /// HMAC key behind the check-in display. Never selected by any read that
  /// returns to a client — there is a guard test.
  checkInSecret String     @map("check_in_secret")
  active        Boolean    @default(true)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  classes       GymClass[]
  visits        GymVisit[]

  @@map("venues")
}

/// A scheduled group class.
///
/// `startsAt` is a UTC instant, NOT a @db.Date — a deliberate deviation from
/// §3's FitnessSession. A personal session is device-local because it is yours
/// wherever you are; a class at 18:00 is 18:00 IN THE ROOM, and storing a date
/// plus "HH:MM" breaks across a clock change and for anyone in another country.
model GymClass {
  id           String         @id @default(uuid()) @db.Uuid
  venueId      String         @map("venue_id") @db.Uuid
  /// Nullable with SetNull: the class still happened after the coach's account
  /// is gone, and the people who attended it still have a record.
  coachId      String?        @map("coach_id") @db.Uuid
  title        String
  description  String?
  startsAt     DateTime       @map("starts_at")
  /// Minutes, rather than an endsAt: moving a start time would otherwise need
  /// two writes that can disagree.
  durationMin  Int            @map("duration_min")
  capacity     Int
  /// Denormalised, and mutated ONLY by the conditional update inside the
  /// booking transaction (`where: { seatsTaken: { lt: capacity } }`). That
  /// compare-and-increment takes a row lock, which is what makes "capacity
  /// cannot be exceeded" a property of the write rather than a check-then-write
  /// race in a resolver.
  seatsTaken   Int            @default(0) @map("seats_taken")
  status       ClassStatus    @default(SCHEDULED)
  /// Shown to everyone who had booked. A cancellation with no reason is a
  /// notification, not an explanation.
  cancelReason String?        @map("cancel_reason")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  venue        Venue          @relation(fields: [venueId], references: [id], onDelete: Restrict)
  coach        User?          @relation("ClassCoach", fields: [coachId], references: [id], onDelete: SetNull)
  bookings     ClassBooking[]
  visits       GymVisit[]

  @@index([venueId, startsAt])
  @@index([coachId, startsAt])
  @@index([startsAt])
  @@map("gym_classes")
}

model ClassBooking {
  id          String        @id @default(uuid()) @db.Uuid
  classId     String        @map("class_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  status      BookingStatus @default(BOOKED)
  bookedAt    DateTime      @default(now()) @map("booked_at")
  cancelledAt DateTime?     @map("cancelled_at")
  /// Set by a check-in and by nothing else. Attendance is a fact about a body
  /// being in a room — see the transition table in @pulse/shared.
  attendedAt  DateTime?     @map("attended_at")
  gymClass    GymClass      @relation(fields: [classId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The double-booking guard, in the DATABASE rather than in a resolver: a
  /// lost race raises P2002 inside the transaction, which rolls the seat
  /// increment back with it.
  @@unique([classId, userId])
  @@index([userId, bookedAt])
  @@index([classId, status])
  @@map("class_bookings")
}

/// Someone was at a venue.
///
/// `classId` is set only when the scan fell inside the window of a class they
/// had ALREADY booked. A scan with no matching booking is still a real visit —
/// they were there — and records a null class rather than inventing a booking.
model GymVisit {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  venueId     String        @map("venue_id") @db.Uuid
  classId     String?       @map("class_id") @db.Uuid
  source      CheckInSource
  checkedInAt DateTime      @default(now()) @map("checked_in_at")
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue       Venue         @relation(fields: [venueId], references: [id], onDelete: Restrict)
  gymClass    GymClass?     @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@index([userId, checkedInAt])
  @@index([venueId, checkedInAt])
  @@map("gym_visits")
}

enum ClassStatus {
  SCHEDULED
  CANCELLED
}

enum BookingStatus {
  BOOKED
  CANCELLED
  ATTENDED
  NO_SHOW
}

enum CheckInSource {
  QR
  MANUAL
  STAFF
}
