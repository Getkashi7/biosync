generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String              @id @db.Uuid
  email              String              @unique
  fullName           String?             @map("full_name")
  role               Role                @default(USER)
  createdAt          DateTime            @default(now()) @map("created_at")
  invitesAccepted    ClientInvite[]      @relation("InviteClient")
  invitesSent        ClientInvite[]      @relation("InviteStaff")
  consents           Consent[]
  dailyLogs          DailyLog[]
  goals              Goal[]
  meals              Meal[]
  metrics            Metric[]
  readinessSnapshots ReadinessSnapshot[]
  notesReceived      SessionNote[]       @relation("NoteClient")
  notesWritten       SessionNote[]       @relation("NoteTrainer")
  careTeam           StaffLink[]         @relation("StaffLinkClient")
  clients            StaffLink[]         @relation("StaffLinkStaff")
  staffProfiles      StaffProfile[]
  supplementLogs     SupplementLog[]
  supplements        Supplement[]
  plansReceived      TrainingPlan[]      @relation("PlanClient")
  plansWritten       TrainingPlan[]      @relation("PlanTrainer")

  @@map("users")
}

model DailyLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  date         DateTime @db.Date
  sleepHours   Float    @map("sleep_hours")
  sleepQuality Int      @map("sleep_quality")
  energy       Int
  mood         Int
  weightKg     Float?   @map("weight_kg")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@map("daily_logs")
}

model Metric {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  type       MetricType
  value      Float
  source     MetricSource @default(MANUAL)
  recordedAt DateTime     @default(now()) @map("recorded_at")
  createdAt  DateTime     @default(now()) @map("created_at")
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, recordedAt])
  @@map("metrics")
}

model ReadinessSnapshot {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  date      DateTime @db.Date
  score     Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@map("readiness_snapshots")
}

model Meal {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  date        DateTime @db.Date
  description String
  calories    Int
  proteinG    Float    @map("protein_g")
  carbsG      Float    @map("carbs_g")
  fatG        Float    @map("fat_g")
  fiberG      Float?   @map("fiber_g")
  estimated   Boolean  @default(true)
  loggedAt    DateTime @default(now()) @map("logged_at")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("meals")
}

model Supplement {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  name      String
  dose      String
  timings   SupplementTiming[]
  /// * the user's own note on why they take it
  note      String?
  active    Boolean            @default(true)
  createdAt DateTime           @default(now()) @map("created_at")
  logs      SupplementLog[]
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("supplements")
}

model SupplementLog {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  supplementId String           @map("supplement_id") @db.Uuid
  date         DateTime         @db.Date
  timing       SupplementTiming
  createdAt    DateTime         @default(now()) @map("created_at")
  supplement   Supplement       @relation(fields: [supplementId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([supplementId, date, timing])
  @@index([userId, date])
  @@map("supplement_logs")
}

model StaffProfile {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String      @map("user_id") @db.Uuid
  kind       StaffKind
  status     StaffStatus @default(PENDING)
  /// * free text for now: registration number, insurer, etc.
  credential String?
  verifiedAt DateTime?   @map("verified_at")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@index([status])
  @@map("staff_profiles")
}

model StaffLink {
  id        String          @id @default(uuid()) @db.Uuid
  clientId  String          @map("client_id") @db.Uuid
  staffId   String          @map("staff_id") @db.Uuid
  /// *
  ///    * The capacity the staff member acts in for this client.
  ///    *
  ///    * `role` is the legacy column and is being retired: it reused the `Role` enum,
  ///    * which allowed meaningless links (role = ADMIN). `kind` replaces it and is
  ///    * nullable only for the length of the backfill — reads move to `kind`, then
  ///    * `role` is dropped in a later migration. Never change a column's type in
  ///    * place; that generates a destructive migration.
  role      Role
  status    StaffLinkStatus @default(PENDING)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  kind      StaffKind?
  client    User            @relation("StaffLinkClient", fields: [clientId], references: [id], onDelete: Cascade)
  staff     User            @relation("StaffLinkStaff", fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([clientId, staffId, role])
  @@index([staffId, status])
  @@index([clientId, status])
  @@map("staff_links")
}

model ClientInvite {
  id         String    @id @default(uuid()) @db.Uuid
  staffId    String    @map("staff_id") @db.Uuid
  /// * the capacity the resulting link will be held in
  kind       StaffKind
  /// * sha-256 of the normalised code; the plaintext exists only at creation
  codeHash   String    @unique @map("code_hash")
  /// *
  ///    * Optional: when set, only this email may redeem the invite. Stored
  ///    * lower-cased. Null means "anyone holding the code", which is why expiry and
  ///    * single use matter.
  email      String?
  expiresAt  DateTime  @map("expires_at")
  /// * set on redemption; a non-null value means the code is spent
  acceptedAt DateTime? @map("accepted_at")
  acceptedBy String?   @map("accepted_by") @db.Uuid
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  client     User?     @relation("InviteClient", fields: [acceptedBy], references: [id])
  staff      User      @relation("InviteStaff", fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, createdAt])
  @@map("client_invites")
}

model Consent {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  category  ConsentCategory
  audience  ConsentAudience @default(NONE)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId])
  @@map("consents")
}

model TrainingPlan {
  id        String   @id @default(uuid()) @db.Uuid
  trainerId String   @map("trainer_id") @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  /// * ISO week the plan targets, e.g. "2026-W30"
  week      String
  title     String
  items     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  client    User     @relation("PlanClient", fields: [clientId], references: [id], onDelete: Cascade)
  trainer   User     @relation("PlanTrainer", fields: [trainerId], references: [id], onDelete: Cascade)

  @@unique([trainerId, clientId, week])
  @@index([clientId])
  @@map("training_plans")
}

model SessionNote {
  id               String   @id @default(uuid()) @db.Uuid
  trainerId        String   @map("trainer_id") @db.Uuid
  clientId         String   @map("client_id") @db.Uuid
  body             String
  sharedWithClient Boolean  @default(true) @map("shared_with_client")
  createdAt        DateTime @default(now()) @map("created_at")
  client           User     @relation("NoteClient", fields: [clientId], references: [id], onDelete: Cascade)
  trainer          User     @relation("NoteTrainer", fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@index([trainerId, createdAt])
  @@map("session_notes")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  /// * who performed the action
  actorId   String   @map("actor_id") @db.Uuid
  /// * whose record it affected, when that differs from the actor (staff access)
  subjectId String?  @map("subject_id") @db.Uuid
  action    String
  /// * the kind of record touched, e.g. "meal", "supplement"
  entity    String?
  entityId  String?  @map("entity_id")
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([subjectId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model Goal {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @map("user_id") @db.Uuid
  description  String
  targetMetric MetricType? @map("target_metric")
  createdAt    DateTime    @default(now()) @map("created_at")
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("goals")
}

enum Role {
  USER
  ADMIN
  PT
  PRACTITIONER
}

enum MetricType {
  SLEEP_HOURS
  SLEEP_QUALITY
  RESTING_HR
  HRV
  GLUCOSE
  WEIGHT
  HYDRATION
  ENERGY
  MOOD
}

enum ConsentCategory {
  BIOMETRICS
  JOURNAL
  DIAGNOSTICS
  PHOTOS
  ACTIVITY
}

enum ConsentAudience {
  NONE
  TRAINER
  PRACTITIONER
}

enum SupplementTiming {
  AM
  PRE
  PM
}

enum MetricSource {
  MANUAL
  HEALTH_CONNECT
  APPLE_HEALTH
  OURA
  WHOOP
  LIBRE
}

enum StaffKind {
  PT
  PRACTITIONER
}

enum StaffStatus {
  PENDING
  VERIFIED
  SUSPENDED
}

enum StaffLinkStatus {
  PENDING
  ACTIVE
  REVOKED
}
