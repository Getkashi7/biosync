# BIOSYNC API — environment. Copy to .env for local dev; set the same keys as
# secrets on the host (Fly: `fly secrets set KEY=...`). Never commit real values.

# --- Database (Supabase Postgres, eu-west-2) ---------------------------------
# Pooled connection (PgBouncer, port 6543) — used by the running app.
DATABASE_URL="postgresql://postgres:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — used by `prisma migrate deploy` at release.
DIRECT_URL="postgresql://postgres:PASSWORD@HOST:5432/postgres"

# --- Auth (verifying the Supabase access token) ------------------------------
# Project URL — used to fetch the JWKS for asymmetric (ES256/RS256) tokens.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
# Legacy HS256 secret — only for HS256-signed tokens. One of URL/SECRET suffices.
SUPABASE_JWT_SECRET=""

# --- AI Coach (optional) -----------------------------------------------------
# Absent = the chat returns a friendly "not switched on yet" reply.
GROQ_API_KEY=""

# --- Server ------------------------------------------------------------------
PORT=4000
# Bind address. Local dev can use 127.0.0.1; containers MUST use 0.0.0.0.
HOST=0.0.0.0
# "production" narrows CORS to ALLOWED_ORIGINS and quiets error detail.
NODE_ENV=development
# Comma-separated browser origins allowed to call the API (Expo web, the legal
# site). Empty = allow any origin. Native app clients send no Origin and are
# never affected by this.
ALLOWED_ORIGINS=""
