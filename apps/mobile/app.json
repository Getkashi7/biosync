{
  "expo": {
    "name": "BIOSYNC",
    "slug": "pulse",
    "owner": "kaze7777",
    "scheme": "pulse",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "backgroundColor": "#0B0B12",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.pulse.mobile"
    },
    "android": {
      "package": "app.pulse.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0B0B12"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#0B0B12",
          "resizeMode": "contain",
          "imageWidth": 170
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF7A6E"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BIOSYNC uses your photo library only for progress photos you choose to add. They are stored privately and are never shared unless you turn sharing on yourself.",
          "cameraPermission": "BIOSYNC uses the camera only for progress photos you take. They are stored privately and are never shared unless you turn sharing on yourself."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5224aedb-46a1-4c63-b703-a01121802659"
      }
    }
  }
}
